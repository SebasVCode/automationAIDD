# Credenciales de acceso a AIDD
AIDD_URL=https://tu-dominio-aidd.com/login
AIDD_USERNAME=tu_usuario
AIDD_PASSWORD=tu_contrasena

# URL de la pantalla donde se ven las PQRs (después de iniciar sesión)
AIDD_PQRS_URL=https://tu-dominio-aidd.com/pqrs

# Selectores CSS del formulario de login (ajustar según el HTML real de AIDD)
# IMPORTANTE: los valores que empiezan con # deben ir entre comillas,
# si no, todo lo que sigue al # se lee como un comentario y queda vacío.
SELECTOR_USERNAME_INPUT="#username"
SELECTOR_PASSWORD_INPUT="#password"
SELECTOR_LOGIN_BUTTON=button[type="submit"]

# Selector de la tabla/contenedor de PQRs que se debe capturar
SELECTOR_PQRS_TABLE="#tabla1"

# Carpeta donde se guardan los pantallazos (enfoque OCR, en desuso)
SCREENSHOT_DIR=./screenshots

# --- Extracción directa por HTML (enfoque actual) ---

# Selector de cada fila de PQR dentro de la tabla
SELECTOR_FILA_PQRS=table#tabla1 tbody tr[align="center"]

# Selector del indicador de color/estado dentro de cada fila
SELECTOR_BALL=.auto-gravity

# Patrón (regex) que debe cumplir el radicado para considerar la fila una
# PQR real. Descarta encabezados, selectores de cantidad y paginación que
# también usan la clase .auto-gravity. Ajusta si tu formato de radicado
# es distinto a "SPTO-RM-2026-00002029".
PATRON_RADICADO=^[A-Z]{2,10}-[A-Z0-9]{1,6}-\d{4}-\d+$

# Colores de referencia (formato HEX) para clasificar cada PQR.
# Ajusta estos valores con el color REAL que veas en DevTools:
# click derecho sobre la bolita -> Inspeccionar -> pestaña "Computed" ->
# busca "background-color" -> ahí sale el valor exacto (puede estar en rgb,
# conviértelo a hex en https://www.rgbtohex.net/ si hace falta).
# También van entre comillas por la misma razón del # explicada arriba.
COLOR_VERDE="#4CAF50"
COLOR_AMARILLO="#FFC107"
COLOR_NARANJA="#FF9800"
COLOR_ROJO="#F44336"

# Carpeta donde se guardan los datos extraídos (JSON) y diagnósticos
OUTPUT_DIR=./output

# Pon en false (sin comillas) para ver el navegador durante el diagnóstico
HEADLESS=true

# --- Servidor HTTP (para que n8n.cloud pueda llamar la extracción) ---

# Clave secreta que n8n debe enviar en el header x-api-key.
# Invéntate un texto largo y difícil de adivinar, ej: usa un generador
# de contraseñas y pon el resultado aquí (sin espacios).
API_KEY=cambia-esto-por-una-clave-larga-y-secreta

# Puerto donde corre el servidor (déjalo así salvo que tengas conflicto)
PORT=3000
